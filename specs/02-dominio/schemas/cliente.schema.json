{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/cliente.schema.json",
  "title": "Customer (buyer)",
  "description": "UBL cac:AccountingCustomerParty. CU-01. Rules R-11, R-12.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documento",
    "nombre"
  ],
  "properties": {
    "id": {
      "$ref": "comun.schema.json#/$defs/uuid"
    },
    "documento": {
      "$ref": "comun.schema.json#/$defs/documentoIdentidad"
    },
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Legal name or full name. UBL cac:PartyLegalEntity/cbc:RegistrationName"
    },
    "direccion": {
      "$ref": "comun.schema.json#/$defs/direccion"
    },
    "correo": {
      "type": "string",
      "format": "email"
    }
  }
}