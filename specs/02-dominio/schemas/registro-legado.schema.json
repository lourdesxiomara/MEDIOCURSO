  "required": [
    "id",
    "fecha",
    "ingreso",
    "salida",
    "producto",
    "nro_documento"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "fecha": {
      "type": "string"
    },
    "ingreso": {
      "type": "string"
    },
    "salida": {
      "type": "string"
    },
    "producto": {
      "type": "string"
    },
    "nro_documento": {
      "type": "string"
    }
  }
}