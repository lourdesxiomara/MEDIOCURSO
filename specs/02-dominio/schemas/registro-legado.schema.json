{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/registro-legado.schema.json",
  "title": "RegistroLegado",
  "description": "Legacy system row as exported (CU-13 input). Deliberately permissive: defects are handled by the migration.",
