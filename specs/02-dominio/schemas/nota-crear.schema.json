{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/nota-crear.schema.json",
  "title": "CrearNotaRequest",
  "description": "Input for a credit note (CU-05) or debit note (CU-06). The affected document goes in the path. R-40..R-42.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serie",
    "motivo",
    "sustento"
  ],
  "properties": {
    "serie": {
      "$ref": "comun.schema.json#/$defs/serie"
    },
    "fechaEmision": {
      "$ref": "comun.schema.json#/$defs/fecha"
    },
    "motivo": {
      "type": "string",
      "pattern": "^\\d{2}$",
      "description": "Catalog 09 (credit) or 10 (debit); the path determines which one is validated."
    },
    "sustento": {
      "type": "string",
      "minLength": 5,
      "maxLength": 250
    },
    "lineas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cantidad",
          "precioUnitario"
        ],
        "properties": {
          "productoId": {
            "$ref": "comun.schema.json#/$defs/uuid"
          },
          "codigoProducto": {
            "type": "string",
            "maxLength": 30
          },
          "descripcion": {
            "type": "string",
            "maxLength": 500,
            "description": "If omitted, taken from the product."
          },
          "unidadMedida": {
            "$ref": "comun.schema.json#/$defs/catalogo03"
          },
          "cantidad": {
            "$ref": "comun.schema.json#/$defs/cantidad"
          },
          "precioUnitario": {
            "allOf": [
              {
                "$ref": "comun.schema.json#/$defs/montoUnitario"
              }
            ],
            "description": "Tax-inclusive price (cat. 16 = 01). The system computes the unit value."
          },
          "afectacionIgv": {
            "$ref": "comun.schema.json#/$defs/catalogo07"
          },
          "descuento": {
            "$ref": "comun.schema.json#/$defs/montoDecimal"
          }
        },
        "anyOf": [
          {
            "required": [
              "productoId"
            ]
          },
          {
            "required": [
              "codigoProducto"
            ]
          }
        ]
      },
      "description": "Mandatory for per-item reasons (credit note 05, 07) and for debit notes."
    }
  }
}