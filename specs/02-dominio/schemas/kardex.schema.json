{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/kardex.schema.json",
  "title": "Kardex",
  "description": "Format 12.1 for one stock item and period: opening balance (first row, table 12 = 16), movements and closing balance. Response of GET /inventario/kardex (CU-12). Rules R-60 to R-66.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "periodo",
    "ruc",
    "codigoEstablecimiento",
    "codigoExistencia",
    "saldoInicial",
    "movimientos",
    "totalEntradas",
    "totalSalidas",
    "saldoFinal"
  ],
  "properties": {
    "periodo": {
      "$ref": "comun.schema.json#/$defs/periodoPle"
    },
    "ruc": {
      "$ref": "comun.schema.json#/$defs/ruc"
    },
    "codigoEstablecimiento": {
      "type": "string",
      "pattern": "^\\d{4,7}$"
    },
    "codigoExistencia": {
      "type": "string",
      "maxLength": 24
    },
    "saldoInicial": {
      "$ref": "comun.schema.json#/$defs/cantidadPle"
    },
    "movimientos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "movimiento-inventario.schema.json"
      }
    },
    "totalEntradas": {
      "$ref": "comun.schema.json#/$defs/cantidadPle",
      "description": "Σ inputs of the period, excluding the opening balance."
    },
    "totalSalidas": {
      "$ref": "comun.schema.json#/$defs/cantidadPle"
    },
    "saldoFinal": {
      "$ref": "comun.schema.json#/$defs/cantidadPle",
      "description": "saldoInicial + totalEntradas − totalSalidas (R-65)."
    },
    "archivoPle": {
      "type": "string",
      "pattern": "^LE\\d{11}\\d{6}00120100\\d{2}[01][01][12]1\\.txt$",
      "description": "PLE file name for the 12.1 export (R-66)."
    }
  }
}